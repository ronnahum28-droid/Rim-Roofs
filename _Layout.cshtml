<!doctype html>
<html lang="he" dir="rtl">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#a84d35">
<meta name="description" content="רון נחום — גגות רעפים, תיקונים ואיטום. שירותים ומחשבון אומדן לעבודת הגג שלכם.">
<title>@ViewData["Title"] | Rim Roofs — רון נחום</title>
<script src="~/js/navigation.js" asp-append-version="true" defer></script>
<link rel="stylesheet" href="~/css/RIMROOFS.STYLESHEETS.CSS" asp-append-version="true">
</head><body class="@(ViewData["Home"] is true ? "home-site" : "inner-site")">
<a class="skip" href="/#main">דלגו לתוכן</a>
<header class="header"><div class="container nav">
  <a href="/" class="brand" aria-label="Rim Roofs — לעמוד הבית"><svg viewBox="0 0 48 40" aria-hidden="true"><path d="M3 23 24 5 45 23M10 29 24 17 38 29M17 35 24 29 31 35"/></svg><span><b dir="ltr">RIM ROOFS<span class="brand-dot">.</span></b><small>רון נחום · גגות רעפים</small></span></a>
  <button class="menu-toggle" aria-controls="navigation" aria-expanded="false" aria-label="פתיחת תפריט">☰</button>
  <nav id="navigation" aria-label="ניווט ראשי"><a href="/About">אודות</a><a href="/#services">המומחיות שלנו</a><a>כניסה</a><a>הרשמה</a></a><a href="/#projects">השראה לגג שלכם</a><a href="/#calculator">מחשבון מחירים</a><a class="button small" href="/#contact">בואו נדבר <span>↙</span></a></nav>
</div></header>

@RenderBody()
<footer class="container footer"><a class="brand" href="/"><b dir="ltr">RIM ROOFS.</b></a><span>רון נחום · גגות רעפים ומחשבון מחירים</span><a class="text-link" href="/Privacy">פרטיות</a>
@if (ViewData["Home"] is true) { <button class="text-link" id="admin-open">ניהול · הדגמה ↗</button> }<small>© @DateTime.Now.Year Rim Roofs</small></footer>

@await RenderSectionAsync("Scripts", required: false)
</body></html>