@page
@model IndexModel
layout = null
@{ ViewData["Title"] = "גגות רעפים ומחשבון מחירים"; ViewData["Home"] = true; }

<main id="main">
<section class="cinematic-hero" aria-labelledby="hero-title">
<div class="hero-grain" aria-hidden="true"></div>
<div class="container hero-grid">
<div class="hero-copy"><p class="eyebrow"><span></span> רון נחום / מלאכת הגג</p>
<h1 id="hero-title">מעל הכול.<br><em>הבית שלכם.</em></h1>
<p class="hero-description">גג הוא לא רק מה שמעלינו.<br>הוא הביטחון, האופי והתחושה שהגענו הביתה.</p>
<div class="actions"><a class="button" href="#contact">בואו נבנה משהו שיישאר <span>↙</span></a><a class="hero-secondary" href="#calculator">למחשבון הגג <span>←</span></a></div>
<div class="hero-credentials"><span>בנייה מדויקת</span><i></i><span>חומרים עם אופי</span><i></i><span>עסק משפחתי</span></div>
</div>
<div class="roof-stage"><div class="stage-top"><span dir="ltr">THE ART OF ROOFING</span><span><i></i> נבנה לפרטים</span></div>
<canvas id="roof-cinema" aria-label="הדמיה אדריכלית מונפשת: קורות ורעפי טרקוטה מתחברים לגג של בית" role="img"></canvas>
<noscript><img class="canvas-fallback" src="/images/roof-placeholder.svg" alt="איור בית עם גג רעפים"></noscript>
<div class="stage-orbit orbit-one" aria-hidden="true"></div><div class="stage-orbit orbit-two" aria-hidden="true"></div>
<div class="material-note"><span class="material-swatch"></span><div><small>חומר טבעי. אופי נצחי.</small><b>טרקוטה / TERRACOTTA</b></div><span class="material-line"></span></div>
<div class="stage-bottom"><span dir="ltr">DESIGNED TO SHELTER. BUILT TO LAST.</span><button id="replay-cinema" type="button" aria-label="הפעלה חוזרת של אנימציית בניית הגג"><span>↻</span> לצפות בבנייה מחדש</button></div>
</div></div>
<div class="container hero-baseline"><a href="#services"><span class="scroll-arrow">↓</span> כל בית מתחיל בסיפור. שלנו מתחיל בגג.</a><span dir="ltr">RIM ROOFS — ROOFING & CRAFT</span></div>
</section>
<dialog id="entrance-film" aria-label="פתיח מונפש של Rim Roofs">
<button id="skip-entrance" type="button" autofocus>דלגו לאתר <span>←</span></button>
<div class="entrance-center"><svg viewBox="0 0 200 120" aria-hidden="true"><path class="intro-roof roof-first" d="M20 75 100 15 180 75"/><path class="intro-roof roof-second" d="M43 90 100 47 157 90"/><path class="intro-roof roof-third" d="M69 105 100 82 131 105"/></svg><p class="intro-wordmark" dir="ltr">RIM ROOFS<span>.</span></p><p class="intro-tagline">מלאכת מחשבת. שקט בבית.</p></div>
<div class="intro-bottom"><span dir="ltr">A HOME BEGINS ABOVE.</span><div class="intro-progress"></div><span>רון נחום · גגות רעפים</span></div>
</dialog>
<div class="values"><div class="container"><span>גגות שמרגישים כמו בית</span><span>תכנון מוקפד <i>✦</i></span><span>חומרים נכונים <i>✦</i></span><span>ידיים מקצועיות <i>✦</i></span><span>יחס אישי <i>✦</i></span></div></div>
<section id="services" class="section container reveal"><div class="section-head"><div><p class="eyebrow">01 / המומחיות שלנו</p><h2>לכל גג, הפתרון שלו.</h2></div><p>מהרעף הראשון ועד התיקון הקטן.<br>מתחילים בהקשבה, ממשיכים בעבודה מדויקת.</p></div><div class="services-grid">
<a class="service" href="#calculator" data-work="installation"><span class="service-number">01</span><span class="service-icon"><svg viewBox="0 0 32 34" aria-hidden="true"><path d="M3 15 16 4 29 15M7 13v15h18V13M13 28v-9h6v9"/></svg></span><h3>בניית גג חדש</h3><p>תכנון וביצוע גג רעפים שמשתלב בבית שלכם, עם מחשבה על המבנה, המראה והפרטים.</p><span class="service-link">מתכננים יחד <b>↙</b></span></a>
<a class="service" href="#calculator" data-work="replacement"><span class="service-number">02</span><span class="service-icon"><svg viewBox="0 0 32 34" aria-hidden="true"><path d="m3 12 13-8 13 8-13 8Zm0 6 13 8 13-8M3 24l13 8 13-8"/></svg></span><h3>חידוש והחלפת רעפים</h3><p>מחדשים את המראה ואת ההגנה של הבית, עם התאמה נכונה של הרעפים לגג הקיים.</p><span class="service-link">נותנים לגג חיים חדשים <b>↙</b></span></a>
<a class="service" href="#calculator" data-work="waterproofing"><span class="service-number">03</span><span class="service-icon"><svg viewBox="0 0 32 34" aria-hidden="true"><path d="M16 3S6 15 6 21a10 10 0 0 0 20 0C26 15 16 3 16 3Z"/><path d="M11 22a5 5 0 0 0 5 5"/></svg></span><h3>איטום והגנה</h3><p>בדיקת נקודות התורפה והתאמת פתרון איטום למפגשים, לחיבורים ולתנאי הגג.</p><span class="service-link">מתכוננים לחורף <b>↙</b></span></a>
<a class="service" href="#calculator" data-work="repair"><span class="service-number">04</span><span class="service-icon"><svg viewBox="0 0 32 34" aria-hidden="true"><path d="m7 27 13-13M20 14a7 7 0 0 0 9-9l-5 5-4-4 5-5a7 7 0 0 0-9 9L3 23a3 3 0 0 0 4 4Z"/></svg></span><h3>תיקונים ותחזוקה</h3><p>רעף שבור או סימן לרטיבות? מאתרים את מקור הבעיה ובוחנים את התיקון המתאים.</p><span class="service-link">מטפלים בפרטים <b>↙</b></span></a>
</div></section>
<section id="calculator" class="calculator-section"><div class="container calculator-layout reveal"><div class="calculator-intro"><p class="eyebrow">02 / מתחילים במספרים</p><h2>גג חדש בראש?<br>בואו נעשה <em>חשבון.</em></h2><p>בחרו את סוג העבודה ואת שטח הגג,<br>וקבלו מושג ראשוני על התקציב.</p><div class="calc-note"><span>↳</span><p>כל גג הוא סיפור אחר.<br><small>התמחור כאן להמחשה בלבד. הצעה מחייבת תינתן לאחר בדיקה בשטח ובהתאם למורכבות העבודה והחומרים.</small></p></div></div><div class="calculator-card"><div class="field-title"><h3>מה הגג שלכם צריך?</h3><span>שלב 01</span></div><div class="work-options" role="group" aria-label="סוג העבודה"><button data-type="installation" aria-pressed="true">בנייה חדשה</button><button data-type="replacement" aria-pressed="false">החלפת רעפים</button><button data-type="repair" aria-pressed="false">תיקון גג</button><button data-type="waterproofing" aria-pressed="false">איטום</button></div><div class="field-title area-title"><label for="area">מה שטח הגג?</label><span><output id="area-output" for="area">100</output> מ״ר</span></div><input id="area" type="range" min="10" max="500" step="5" value="100"><div class="range-labels"><span>10 מ״ר</span><span>500 מ״ר</span></div><div class="estimate"><span>טווח עלות משוער · להמחשה</span><output id="estimate" aria-live="polite" dir="ltr"></output><small>כולל מע״מ לצורך ההדגמה · אינו הצעת מחיר</small></div><a class="button full" id="quote-link" href="#contact">נדייק את ההצעה יחד <span>←</span></a><p class="calculator-foot">משאירים פרטים לתיאום שיחה או ביקור</p></div></div></section>
<section id="projects" class="section container reveal"><div class="section-head"><div><p class="eyebrow">03 / חומר, צורה, השראה</p><h2>השראה לגג הבא שלכם.</h2></div><p>גלריית השראה להמחשת העיצוב.<br>תמונות פרויקטים אמיתיות יתווספו על ידי העסק.</p></div><div class="gallery" id="gallery"></div></section>
<section class="process container reveal"><p class="eyebrow">בגובה העיניים, בכל שלב</p><h2>מהשיחה הראשונה ועד הגג המוכן.</h2><div class="process-grid"><div><b>01</b><h3>מדברים ומבינים</h3><p>מספרים לנו על הבית ועל מה שהגג צריך.</p></div><div><b>02</b><h3>בודקים ומתכננים</h3><p>מתאמים בדיקה, בוחנים אפשרויות ומגבשים הצעה.</p></div><div><b>03</b><h3>בונים ומחדשים</h3><p>מתאמים את העבודה ומקדישים תשומת לב לכל פרט.</p></div></div></section>
<section id="contact" class="contact-section"><div class="container contact-layout reveal"><div><p class="eyebrow">04 / הבית שלכם בידיים טובות</p><h2>נדבר על<br>מה שמעליכם?</h2><p>בנייה חדשה, תיקון קטן או שאלה גדולה.<br>השאירו פרטים ונתחיל משיחה.</p><div class="signature">רון נחום<span>גגות רעפים · Rim Roofs</span></div></div><form id="contact-form"><p class="demo-notice">טופס הדגמה: הפרטים נשמרים בדפדפן הזה בלבד ואינם נשלחים לעסק. אין להזין מידע רגיש.</p><div class="form-row"><label>שם מלא<input name="name" autocomplete="name" required minlength="2" maxlength="80" placeholder="איך קוראים לכם?"></label><label>טלפון<input name="phone" type="tel" dir="ltr" autocomplete="tel" required pattern="[+0-9 ()\-]{9,20}" maxlength="20" placeholder="050-0000000"></label></div><div class="form-row"><label>יישוב<input name="city" autocomplete="address-level2" maxlength="80" placeholder="איפה הבית נמצא?"></label><label>איך מתקדמים?<select name="request"><option>שיחת ייעוץ</option><option>תיאום ביקור</option><option>הצעת מחיר</option></select></label></div><label>ספרו לנו קצת על הגג<textarea name="message" rows="3" maxlength="2000" placeholder="סוג העבודה, מצב הגג וכל מה שכדאי לדעת..."></textarea></label><label class="consent"><input name="consent" type="checkbox" required> אני מסכים/ה לשמירת פרטי ההדגמה בדפדפן הזה.</label><button class="button full" type="submit">שמירת פנייה להדגמה <span>↙</span></button><p id="form-status" role="status"></p></form></div></section>
</main>

<dialog id="lightbox" aria-label="צפייה בתמונת גלריה"><button class="close" data-close aria-label="סגירה">×</button><img id="lightbox-image" alt=""><p id="lightbox-caption"></p><div class="lightbox-nav"><button id="previous-image" aria-label="תמונה קודמת">→</button><span id="image-position"></span><button id="next-image" aria-label="תמונה הבאה">←</button></div></dialog>
<dialog id="admin" aria-labelledby="admin-title"><button class="close" data-close aria-label="סגירה">×</button><p class="eyebrow">RIM ROOFS / STUDIO</p><h2 id="admin-title">ניהול העסק</h2><p class="demo-notice">הדגמה מקומית ללא התחברות. הפניות נשמרות רק בדפדפן זה; תמונות שהועלו זמינות עד רענון הדף. זה אינו אזור ניהול מאובטח.</p><div class="admin-tabs" role="group" aria-label="תצוגת ניהול"><button class="active" data-panel="leads">פניות <span id="lead-count">0</span></button><button data-panel="uploads">תמונות</button></div><section id="leads-panel"><div id="leads-list"></div><button class="text-link danger" id="clear-leads">מחיקת פניות ההדגמה</button></section><section id="uploads-panel" hidden><form id="upload-form"><label>כותרת התמונה<input name="title" required maxlength="100" placeholder="למשל: חידוש גג רעפים"></label><label>תמונת פרויקט (עד 5MB)<input name="photo" type="file" accept="image/jpeg,image/png,image/webp" required></label><button class="button" type="submit">הוספה לגלריית ההדגמה</button><p id="upload-status" role="status"></p></form></section></dialog>

@section Scripts {
<script src="~/js/roof-cinema.js" asp-append-version="true" defer></script>
<script src="~/js/rim-roofs.js" asp-append-version="true" defer></script>
}
